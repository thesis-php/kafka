includes:
    - /composer/vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: max
    paths:
        - examples
        - src
        - generator
        - tests
    tmpDir: var/phpstan
    editorUrl: ''
    editorUrlTitle: '%%relFile%%:%%line%%'

    # strict rules
    checkBenevolentUnionTypes: true
    checkMissingCallableSignature: true
    checkUninitializedProperties: true
    rememberPossiblyImpureFunctionValues: false
    reportAlwaysTrueInLastCondition: true
    reportAnyTypeWideningInVarTag: true
    reportPossiblyNonexistentConstantArrayOffset: true
    reportPossiblyNonexistentGeneralArrayOffset: true
    ignoreErrors:
        -
            message: '#Parameter \#2 \$version of static method Thesis\\Kafka\\Protocol\\Generated\\LeaderChangeMessage\\Voter::decode\(\) expects int<0, max>, int given\.#'
            path: src/Protocol/Generated/LeaderChangeMessage.php
            count: 2
        -
            message: '#Parameter \#2 \$version of static method Thesis\\Kafka\\Protocol\\Generated\\VotersRecord\\Voter::decode\(\) expects int<0, max>, int given\.#'
            path: src/Protocol/Generated/VotersRecord.php
            count: 1
