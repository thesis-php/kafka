{
    "name": "thesis/kafka",
    "description": "Feature complete, pure async PHP library for Kafka.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "kafkiansky",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Thesis Team",
            "homepage": "https://github.com/orgs/thesis-php/people"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "ext-ctype": "*",
        "amphp/amp": "^3.1",
        "amphp/pipeline": "^1.2",
        "amphp/socket": "^2.4",
        "amphp/sync": "^2.3",
        "ramsey/uuid": "^4.9",
        "revolt/event-loop": "^1.0",
        "thesis/endian": "^0.3.3",
        "thesis/exceptionally": "^0.3.0",
        "thesis/package-version": "^0.1.2",
        "thesis/time-span": "^0.2.3",
        "thesis/varint": "^0.2.0"
    },
    "require-dev": {
        "colinodell/json5": "^3.0",
        "cuyz/valinor": "^2.4",
        "nette/php-generator": "^4.2.1",
        "nikic/php-parser": "^5.7",
        "symfony/var-dumper": "^8.0",
        "testo/assert": "^0.1.1",
        "testo/codecov": "^0.1.5",
        "testo/data": "^0.1.3",
        "testo/retry": "^0.1.1",
        "testo/test": "^0.1.1",
        "testo/testo": "^0.10.5"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\Kafka\\": "src/"
        },
        "files": [
            "src/Compressor/compression.php",
            "src/Internal/Time/Duration.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\Kafka\\": "tests/",
            "Thesis\\Kafka\\Generator\\": "generator/"
        }
    },
    "config": {
        "lock": false,
        "sort-packages": true
    }
}
