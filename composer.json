{
    "name": "thesis/kafka",
    "description": "Feature complete, pure async PHP library for Kafka.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "kafkiansky",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Thesis Team",
            "homepage": "https://github.com/orgs/thesis-php/people"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "thesis/endian": "^0.3.3",
        "thesis/varint": "^0.2.0"
    },
    "require-dev": {
        "colinodell/json5": "^3.0",
        "cuyz/valinor": "^2.4",
        "nette/php-generator": "^4.2.1",
        "nikic/php-parser": "^5.7",
        "phpunit/phpunit": "^12.4",
        "symfony/var-dumper": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\Kafka\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\Kafka\\": "tests/",
            "Thesis\\Kafka\\Generator\\": "generator/"
        }
    },
    "config": {
        "lock": false,
        "sort-packages": true
    }
}
