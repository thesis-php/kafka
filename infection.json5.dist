{
    "testFramework": "testo",
    "source": {
        "directories": [
            "src"
        ],
        "excludes": [
            // Generated code is not written by hand. The goal of 100% MSI is about hand-written code.
            "Protocol/Generated"
        ]
    },
    "logs": {
        "text": "var/infection.log",
        "stryker": {
            "report": "/^(?>main|\\d+\\.\\d+\\.x)$/D"
        },
    },
    "tmpDir": "var",
    // Three full runs gave 58-64%. Mutants killed by a timeout change from run to run, so the threshold has a margin.
    // Raise this number when tests get better. The goal is 100.
    "minCoveredMsi": 55,
    "mutators": {
        "@default": true,
    },
}
