{
    "testFramework": "testo",
    "source": {
        "directories": [
            "src"
        ]
    },
    "logs": {
        "text": "var/infection.log",
        "stryker": {
            "report": "/^(?>main|\\d+\\.\\d+\\.x)$/D"
        },
    },
    "tmpDir": "var",
    // The current level is 66-68%. Raise this number when tests get better. The goal is 100.
    "minCoveredMsi": 60,
    "mutators": {
        "@default": true,
    },
}
